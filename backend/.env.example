# Backend environment. Copy to `.env` and fill in real values.
# Never commit `.env`; it is git-ignored.

NODE_ENV=development
SERVER_PORT=5000

# Origin the browser uses, i.e. the Next.js client. Used to build links that
# are emailed or logged back to the user (for example password reset).
CLIENT_BASE_URL=http://localhost:3001

# --- Postgres (host-side tooling; Compose uses the service name internally) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pdfrag?schema=public"

# --- Qdrant ---
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION=pdf_rag_collection

# --- Redis (BullMQ) ---
REDIS_URL="redis://:password@localhost:6379"

# --- MinIO ---
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minio"
MINIO_SECRET_KEY="change-me"
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# --- LLM / embedding ---
# OPENROUTER_API_KEY=sk-or-v1-...
# NOTE: the free tier has a hard daily request cap. Once it returns
# "429 free-models-per-day", question enrichment cannot run at all and every
# document stays without hypothetical questions. Use a credited key.
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free

QUESTIONS_PER_CHUNK=6

# --- Uploads / chat limits ---
MAX_UPLOAD_BYTES=26214400
MAX_DOCS_PER_USER=5
CHAT_MAX_HISTORY_CHARS=12000



# --- Server behaviour ---
# Comma-separated browser origins allowed to open the chat websocket.
ALLOWED_WS_ORIGINS=http://localhost:3001
# Set when running behind a reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# --- Optional: Clerk auth (unused unless you switch providers) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_PEM=

# --- Auth ---
JWT_SECRET=generate-a-long-random-value

# Google OAuth redirect URI must exactly match the URI registered in the Google
# Cloud console. With the client on :3001 proxying /api to the backend on :3000,
# that is http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Dev-only escape hatches. Never enable on a shared or public host: they hand
# privileged access to anyone who can reach the service.
ALLOW_DEV_AUTH=false
DEV_PASSWORD_RESET=false
