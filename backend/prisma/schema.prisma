generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A signed-in user (synced from Clerk via the `sub` claim, or created with a
// local email/password when Clerk is not configured).
model User {
  id           String   @id @default(cuid())
  clerkId      String?  @unique @map("clerk_id")
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  imageUrl     String?  @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  documents    Document[]
  chatSessions ChatSession[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// A single-use password-reset link. Only the SHA-256 hash of the token is
// stored, so a dump of this table cannot be replayed against
// /auth/reset-password. Hashing with SHA-256 rather than bcrypt is deliberate:
// the token is 32 bytes of CSPRNG output, so it has no guessable low-entropy
// structure for a slow KDF to defend, and bcrypt here would only add latency.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Supports the expiry sweep that deletes rows nobody ever came back to use.
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// A PDF uploaded by a user. Each user can have at most MAX_DOCS (5).
model Document {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  objectName  String   @map("object_name")
  originalName String  @map("original_name")
  size        Int
  mimeType    String   @map("mime_type")
  totalPages  Int?     @map("total_pages")
  totalChunks Int?     @map("total_chunks")
  status      String   @default("processing") // processing | ready | failed
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]

  @@index([userId])
  @@map("documents")
}

// One chat "session"/conversation per user. Title is generated from the first message.
model ChatSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  documentId String? @map("document_id")
  title     String   @default("New chat")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

model Message {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  role      String // user | ai
  content   String @db.Text
  citations Json?
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}
